# Runtime paths
QWEN36_BACKEND_TYPE=llamacpp
QWEN36_LLAMA_SERVER=/Users/yukimi/.rencrow/runtimes/llama.cpp/b10327/llama-server
QWEN36_MODEL=/Users/yukimi/models/Qwen3.6-27B-Uncensored-Heretic-v2-GGUF/Qwen3.6-27B-uncensored-heretic-v2-Q4_K_M.gguf
QWEN36_PYTHON=/Users/yukimi/RenCrow/RenCrow_LLM/.venv/bin/python3
QWEN36_RUNTIME_CWD=/Users/yukimi/RenCrow/RenCrow_LLM
QWEN36_RENCROW_START_SCRIPT=/Users/yukimi/RenCrow/RenCrow_LLM/scripts/start_mlx_vlm_backend.sh
QWEN36_DIRECT_START=0
QWEN36_USE_MGMT=1
QWEN36_MGMT_BASE=http://127.0.0.1:8079

# Network
QWEN36_HOST=0.0.0.0
QWEN36_BACKEND_PORT=18084
QWEN36_BACKEND_BASE=http://127.0.0.1:18084
QWEN36_PROXY_BASE=http://127.0.0.1:8084

# llama.cpp. A 256-token recurrent checkpoint interval keeps the stable
# SystemPrompt reusable when only the final user message changes.
QWEN36_LLAMA_CONTEXT_SIZE=65536
QWEN36_LLAMA_PARALLEL=1
QWEN36_LLAMA_GPU_LAYERS=999
QWEN36_LLAMA_FLASH_ATTN=auto
QWEN36_LLAMA_CACHE_TYPE_K=q8_0
QWEN36_LLAMA_CACHE_TYPE_V=q8_0
QWEN36_LLAMA_CACHE_RAM_MIB=8192
QWEN36_LLAMA_CHECKPOINT_MIN_STEP=256
QWEN36_LLAMA_CTX_CHECKPOINTS=32
QWEN36_LLAMA_ALIASES=Wild64K,Wild

# Direct-start knobs. These are opt-in because the RenCrow_LLM start script is
# the runtime path verified to generate reliably on this host.
QWEN36_MAX_KV_SIZE=
# Leave KV quantization disabled by default. In this local mlx_vlm build,
# 4-bit uniform KV starts successfully but crashes on the first generation.
QWEN36_KV_BITS=
QWEN36_KV_QUANT_SCHEME=uniform
QWEN36_KV_GROUP_SIZE=64
QWEN36_QUANTIZED_KV_START=0
QWEN36_PREFILL_STEP_SIZE=
QWEN36_MAX_TOKENS=

# MLX fallback cache settings. CORE and the RenCrow LLM Gateway remain
# cache-agnostic regardless of the selected Backend.
QWEN36_APC_ENABLED=1
QWEN36_APC_BLOCK_SIZE=16
QWEN36_APC_NUM_BLOCKS=2048

# Process files
QWEN36_RUN_DIR=run
QWEN36_LOG=run/qwen36-backend.log
QWEN36_PID=run/qwen36-backend.pid
